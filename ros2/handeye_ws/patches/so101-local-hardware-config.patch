diff --git a/so101_bringup/launch/so101_teleoperate.launch.py b/so101_bringup/launch/so101_teleoperate.launch.py
--- a/so101_bringup/launch/so101_teleoperate.launch.py
+++ b/so101_bringup/launch/so101_teleoperate.launch.py
@@ -38,6 +38,22 @@ def equals(value, expected):
     return PythonExpression(["'", value, "' == '", expected, "'"])
 
 
+def both_equal(first, first_expected, second, second_expected):
+    return PythonExpression(
+        [
+            "'",
+            first,
+            "' == '",
+            first_expected,
+            "' and '",
+            second,
+            "' == '",
+            second_expected,
+            "'",
+        ]
+    )
+
+
 def generate_launch_description():
     # Launch description lists
     args = []
@@ -80,11 +97,19 @@ def generate_launch_description():
     )
     args.append(expert_arg)
 
+    cameras_arg = DeclareLaunchArgument(
+        'cameras',
+        default_value='false',
+        description='Launch cameras configured by so101_bringup',
+    )
+    args.append(cameras_arg)
+
     model = LaunchConfiguration('model')
     display_config = LaunchConfiguration('display_config')
     display = LaunchConfiguration('display')
     teleop_mode = LaunchConfiguration('teleop_mode')
     expert = LaunchConfiguration('expert')
+    cameras = LaunchConfiguration('cameras')
 
     # Debug: Log the mode
     mode_log = LogInfo(msg=['[TELEOP LAUNCH] Mode is set to: ', teleop_mode])
@@ -142,7 +167,7 @@ def generate_launch_description():
     # Include cameras - ONLY in real mode
     camera_log = LogInfo(
         msg='[TELEOP LAUNCH] Launching cameras',
-        condition=IfCondition(equals(teleop_mode, 'real')),
+        condition=IfCondition(both_equal(teleop_mode, 'real', cameras, 'true')),
     )
     actions.append(camera_log)
 
@@ -150,7 +175,7 @@ def generate_launch_description():
         PythonLaunchDescriptionSource(
             os.path.join(bringup_pkg, 'launch', 'include', 'camera.launch.py')
         ),
-        condition=IfCondition(equals(teleop_mode, 'real')),
+        condition=IfCondition(both_equal(teleop_mode, 'real', cameras, 'true')),
     )
     actions.append(cameras_launch)
 
